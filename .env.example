# Copy values into .env. Never place a real API key in source control.
APP_HOST=127.0.0.1
APP_PORT=8001
APP_PORT_SEARCH_LIMIT=50
# Base directory that relative APP_DATA_DIR and COURSE_SKILL_DIR values resolve
# against. Defaults to the directory holding server.py. Set it to keep project
# data outside the app install; "~" is expanded, and absolute paths win outright.
# NOTE: this file is loaded with override=True, so any value uncommented here
# beats the same variable set in the real environment. Leave it commented if you
# want to relocate the workspace per-run from the shell or a service unit.
# APP_WORK_DIR=/path/to/workspace
APP_DATA_DIR=./data
UPLOAD_MAX_BYTES=20971520
SOURCE_MAX_EXTRACTED_CHARS=500000
SOURCE_MAX_UNCOMPRESSED_BYTES=104857600
COURSE_SKILL_DIR=../course_development_partner/course-development-partner

PURDUE_GENAI_BASE_URL=https://genai.rcac.purdue.edu
PURDUE_GENAI_CHAT_PATH=/api/chat/completions
PURDUE_GENAI_MODEL_ID=REPLACE_WITH_PURDUE_MODEL_ID
PURDUE_GENAI_API_KEY=REPLACE_WITH_YOUR_KEY
PURDUE_GENAI_TIMEOUT_SECONDS=120
PURDUE_GENAI_MAX_TOKENS=900
